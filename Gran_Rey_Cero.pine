TAL_NAME = "CPI"
talIs(int k, int pk) => CP.includes(k)
IVRV_NQ = -0.4706
IVRV_ES = -0.1745
ownCk(int k) =>
    switch k
        0 => 0
        => 0
ckName(int k) =>
    switch k
        0 => "CPI"
        1 => "Normal"
        => ""
ckN(int k, bool es) =>
    switch k
        0 => es ? "98" : "96"
        1 => es ? "1416" : "1342"
        => ""
ownProfile(int tk, int pk, int today) =>
    bool now = CP.includes(tk)
    int  rf  = na(tk) ? today : math.max(tk, today)
    [0, now, now ? tk : nextOf(CP, rf)]
ownNext(int today) =>
    int n1 = nextOf(CP, today)
    ["CPI 08:30", n1, "then", na(n1) ? na : nextOf(CP, addDays(n1, 1))]

// ADR20, built on 15-minute bars so it needs little chart history: mean (high − low) ÷ open of the last 20 complete
// days (at least 15). One for the chosen day, one for the trading day (the clock).
adrCalc(int an) =>
    var array<float> rs = array.new<float>()
    var float o = na
    var float h = na
    var float l = na
    var int   n = 0
    int  m  = hour(time, TZ) * 60 + minute(time, TZ)
    int  dk = anchorKey(an, time)
    bool iw = inWin(an, m)
    bool st = iw and (not iw[1] or dk != dk[1])
    if st
        if n >= 0.94 * winBars(an) and o > 0
            rs.push((h - l) / o)
            if rs.size() > 20
                rs.shift()
        o := open
        h := high
        l := low
        n := 1
    else if iw and not na(o)
        h := math.max(h, high)
        l := math.min(l, low)
        n += 1
    rs.size() >= 15 ? rs.avg() : na
[ADR, ADRtd] = request.security(syminfo.tickerid, "15", [adrCalc(AN), adrCalc(0)])
// ADR20 of the trading day from daily bars (as Kyōka): a 1-minute chart or Bar Replay often loads fewer than the 15 days of
// 15-minute bars the line above needs; the daily bars (the CME 18:00–17:00 trading day) always have them.
// The 15-minute figure stays as the fallback and for the NY-midnight and RTH anchors.
float adrD = request.security(ticker.modify(syminfo.tickerid, backadjustment = backadjustment.off), "D", ta.sma((high - low) / open, 20)[1], lookahead = barmerge.lookahead_on)
ADRtd := na(adrD) ? ADRtd : adrD
ADR := AN == 0 and not na(adrD) ? adrD : ADR
// Higher-timeframe requests. None of them leaks future data:
// · dx4 uses the [1] offset with lookahead_on (the standard non-repainting pattern): last completed week vs 4 weeks before.
// · the weekly OHLC and the monthly high / low are read only on the last bar (the weekly PO3 candle and the WEEK / MONTH
//   rows), where nothing lies ahead: lookahead_on returns the developing week / month there and is never used on history.
// · the daily VIX, DXY ATR and 10Y values go through done(): today's daily value is used only once its session has closed
//   (time_close ≤ the chart bar's time), otherwise the prior day's.
float dx4 = request.security(dxySym, "W", close[1] / close[5] - 1, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[wO, wH, wL, wC] = request.security(syminfo.tickerid, "W", [open, high, low, close], lookahead = barmerge.lookahead_on)
float dxL = request.security(dxySym, timeframe.isintraday ? timeframe.period : "D", close, ignore_invalid_symbol = true)
// completed daily values: a daily bar counts once its session has closed, so evening bars already see that day's close
done(float v0, float v1, int tc) => not na(tc) and tc <= time ? v0 : v1
[vTC, vC0, vC1, vS0, vS1] = request.security(vixSym, "D", [time_close, close, close[1], ta.sma(close, 20), ta.sma(close, 20)[1]], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
float vixL = request.security(vixSym, timeframe.isintraday ? timeframe.period : "D", close, ignore_invalid_symbol = true)
[dTC, dA0, dA1] = request.security(dxySym, "D", [time_close, ta.atr(20), ta.atr(20)[1]], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[yTC, yC0, yC1] = request.security(ylSym, "D", [time_close, close, close[1]], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
float ylL = request.security(ylSym, timeframe.isintraday ? timeframe.period : "D", close, ignore_invalid_symbol = true)
[moH, moL] = request.security(syminfo.tickerid, "M", [high, low], lookahead = barmerge.lookahead_on)
// NQ · ES · RTY (or MNQ · MES · M2K) with their week open, for the readout under the release: the chart's own contract
// month (NQ1! → ES1! · RTY1!, NQZ2026 → ESZ2026 · RTYZ2026); other symbols read the continuous minis
bool   famOk = syminfo.root == "NQ" or syminfo.root == "ES" or syminfo.root == "RTY" or syminfo.root == "MNQ" or syminfo.root == "MES" or syminfo.root == "M2K"
bool   famMc = syminfo.root == "MNQ" or syminfo.root == "MES" or syminfo.root == "M2K"
string famSx = famOk ? str.replace(syminfo.ticker, syminfo.root, "") : "1!"
string famPx = famOk ? syminfo.prefix : "CME_MINI"
idxNm(int i) => famMc ? (i == 0 ? "MNQ" : i == 1 ? "MES" : "M2K") : (i == 0 ? "NQ" : i == 1 ? "ES" : "RTY")
idxTk(int i) => famPx + ":" + idxNm(i) + famSx
wkOpenF() =>
    var float wo = na
    bool nw = ta.change(time("W")) != 0
    if nw or na(wo)
        wo := open
    [open, wo]
[nqO, nqW] = request.security(idxTk(0), timeframe.period, wkOpenF(), ignore_invalid_symbol = true)
[esO, esW] = request.security(idxTk(1), timeframe.period, wkOpenF(), ignore_invalid_symbol = true)
[ryO, ryW] = request.security(idxTk(2), timeframe.period, wkOpenF(), ignore_invalid_symbol = true)
float vPrev = done(vC0, vC1, vTC)                             // VIX prior close
float vAvg  = done(vS0, vS1, vTC)                             // its 20-day average
float dxAtr = done(dA0, dA1, dTC)                             // DXY ATR20 of completed days
float ylPrev = done(yC0, yC1, yTC)

// ═══════════════════════════════════════════════════════════════ Today, live
int  tfM  = math.max(1, int(timeframe.in_seconds() / 60))
int  mod  = hour(time, TZ) * 60 + minute(time, TZ)
int  calK = dateKey(time)
int  key  = anchorKey(AN, time)
bool iwin = inWin(AN, mod)
bool dSt  = iwin and (not iwin[1] or key != key[1])
var float dO = na
var float dH = na
var float dL = na
var float dC = na
var int   dX = na                                         // bar_index of the day's first bar (lines start here)
// drawings placed by bar_index are anchored through `time`, so lines that start at the day's first bar need its
// history: a 1-minute trading day is ~1,380 bars, far past the buffer Pine sizes on its own
max_bars_back(time, 5000)
var int   dK = na
var int   pK = na
var int   dT = 6
if dSt
    pK := dK
    dK := key
    dO := open
    dH := high
    dL := low
    dX := bar_index
    dT := dayType(key, pK)
else if iwin and not na(dO)
    dH := math.max(dH, high)
    dL := math.min(dL, low)
if iwin and not na(dO)
    dC := close

// trading-day (18:00) and RTH trackers for the model levels and the clock
int  tdK   = anchorKey(0, time)
bool tdSt  = tdK != tdK[1]
var float tdO  = na
var float tdH  = na
var float tdL  = na
var float ptdH = na
var float ptdL = na
var int   tdX  = na
var int   tdPK = na
if tdSt
    tdPK := tdK[1]
    ptdH := tdH
    ptdL := tdL
    tdO  := open
    tdH  := high
    tdL  := low
    tdX  := bar_index
else
    tdH := math.max(nz(tdH, high), high)
    tdL := math.min(nz(tdL, low), low)
bool rthSt = mod >= 570 and mod < 975 and (mod[1] < 570 or mod[1] >= 975 or calK != calK[1])
var float rthC  = na
var float rH    = na
var float rL    = na
var float gapPC = na
var float gapCE = na
var float rthO  = na
var float tgGap = na
var float tgPct = na
var int   tgKey = na
if rthSt
    rthO  := open
    tgKey := calK
    tgGap := na(rthC) ? na : open - rthC
    tgPct := na(rthC) or rthC == 0 ? na : (open / rthC - 1) * 100
    gapPC := rthC
    gapCE := na(rthC) ? na : (rthC + open) / 2
    rH    := high
    rL    := low
else if mod >= 570 and mod < 975
    rH := math.max(rH, high)
    rL := math.min(rL, low)
if mod >= 570 and mod < 975
    rthC := close
bool recent = time > timenow - markD * 86400000
// event-day records the chart itself finds; where they exist they take precedence over the built-in ones, and they
// keep the tally current after the built-in history ends
var array<int>   LTd = array.new<int>()
var array<int>   LTt = array.new<int>()
var array<int>   LTr = array.new<int>()
var array<float> LTg = array.new<float>()
var array<float> LTp = array.new<float>()
var int   prvTdO_k = na
var float prvTdO   = na
var int   prvTdPK  = na
int  talEnd = isES ? TAL_END_ES : isNQ ? TAL_END_NQ : 0
if tdSt and not na(prvTdO) and prvTdO_k == tdK[1] and talIs(tdK[1], prvTdPK)
    bool rOk = tgKey == tdK[1] and not na(rthO)
    LTd.push(tdK[1])
    LTt.push(int(math.sign(close[1] - prvTdO)))
    LTr.push(rOk ? int(math.sign(rthC - rthO)) : 0)
    LTg.push(rOk ? tgGap : na)
    LTp.push(rOk ? tgPct : na)
if tdSt
    prvTdO   := open
    prvTdO_k := tdK
    prvTdPK  := tdPK
var float dxTdO = na
if tdSt
    dxTdO := dxL[1]
float dxDay = na(dxTdO) or dxTdO == 0 ? na : dxL / dxTdO - 1
var float dxHi = na
var float dxLo = na
if tdSt or na(dxHi)
    dxHi := dxL
    dxLo := dxL
else if not na(dxL)
    dxHi := math.max(dxHi, dxL)
    dxLo := math.min(dxLo, dxL)
varip int beat = 0
if barstate.isrealtime
    beat += 1


// Level lines and their end labels that run to a time later today (16:14, 17:00, the NFP release) are cut at the latest
// bar and grow with it, so they never run through the candles on the right.
var array<line>  GL  = array.new<line>()
var array<int>   GLE = array.new<int>()
var array<label> GT  = array.new<label>()
var array<int>   GTE = array.new<int>()
trimL(line l, int e) =>
    if e > time
        l.set_x2(time)
        GL.push(l)
        GLE.push(e)
    l
trimT(label t, int e) =>
    if e > time
        t.set_x(time)
        GT.push(t)
        GTE.push(e)
    t

// ═══════════════════════════════════════════════════════════════ Model structure on the price chart
bool gCPI = CP.includes(calK)
bool gAft = CP.includes(tdPK) and not gCPI                   // the trading day after a CPI day
bool gOn  = showStr and recent
bool wkd  = dayofweek(time, TZ) >= 2 and dayofweek(time, TZ) <= 6
var float drH  = na
var float drL  = na
var int   drK  = na
var int   swp  = 0
var line  p0H  = na
var line  p0L  = na
var label p0Ht = na
var label p0Lt = na
int    drEndM = drEnd == "11:00" ? 660 : drEnd == "16:14" ? 974 : 1020
string swTip  = "First side of the pre-CPI range (07:30–08:29) taken after the release. The day's bigger move (from 08:30) went the same way " + (isES ? "67% of the time vs 56% on normal days, but only 53% in 2025–26 (71% in 2018–24)." : "70% of the time vs 56% on normal days, and 71% in 2025–26.")
// stage 1: the pre-CPI range, live from 07:30, plus yesterday's RTH close
if gOn and gCPI
    if mod >= 450 and mod < 510
        if nz(drK) != calK
            drK := calK
            drH := high
            drL := low
            swp := 0
            if showDR0
                p0H  := line.new(time, high, time, high, xloc = xloc.bar_time, color = cDR0, style = lsOf(stDR0), force_overlay = true)
                p0L  := line.new(time, low, time, low, xloc = xloc.bar_time, color = cDR0, style = lsOf(stDR0), force_overlay = true)
                p0Ht := label.new(time, high, "pre-CPI high", xloc = xloc.bar_time, color = #00000000, textcolor = cDR0, style = label.style_label_lower_left, size = lbSz, tooltip = swTip, force_overlay = true)
                p0Lt := label.new(time, low, "pre-CPI low", xloc = xloc.bar_time, color = #00000000, textcolor = cDR0, style = label.style_label_upper_left, size = lbSz, tooltip = swTip, force_overlay = true)
            if showYC and not na(rthC)
                trimL(line.new(keyAt(calK, 450), rthC, keyAt(calK, 974), rthC, xloc = xloc.bar_time, color = color.new(cLvl, 25), style = line.style_dotted, width = 1, force_overlay = true), keyAt(calK, 974))
                trimT(label.new(keyAt(calK, 974), rthC, "yday RTH close", xloc = xloc.bar_time, color = #00000000, textcolor = color.new(cLvl, 15), style = label.style_label_left, size = lbSz, tooltip = "Yesterday's RTH close (16:14 bar): the gap the release opens is measured from here.", force_overlay = true), keyAt(calK, 974))
        else
            drH := math.max(drH, high)
            drL := math.min(drL, low)
            if showDR0 and not na(p0H)
                p0H.set_y1(drH)
                p0H.set_y2(drH)
                p0L.set_y1(drL)
                p0L.set_y2(drL)
                p0Ht.set_y(drH)
                p0Lt.set_y(drL)
    // the range runs right until the release first takes one of its sides
    if showDR0 and drK == calK and not na(p0H) and swp == 0 and mod >= 450 and mod < drEndM
        p0H.set_x2(time)
        p0L.set_x2(time)
    if drK == calK and mod >= 510 and mod < 975 and swp == 0 and not na(drH)
        if low < drL
            swp := -1
            label.new(bar_index, drL, "1st sweep ▼", color = #00000000, textcolor = cDR0, style = label.style_label_upper_right, size = lbSz, tooltip = swTip, force_overlay = true)
        else if high > drH
            swp := 1
            label.new(bar_index, drH, "1st sweep ▲", color = #00000000, textcolor = cDR0, style = label.style_label_lower_right, size = lbSz, tooltip = swTip, force_overlay = true)
    if mod <= 530 and mod + tfM > 530
        line.new(keyAt(calK, 530), close, keyAt(calK, 530), close + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = color.new(cLvl, 60), style = line.style_dotted, force_overlay = true)
    if rthSt and not na(gapCE)
        trimL(line.new(time, gapCE, keyAt(calK, 974), gapCE, xloc = xloc.bar_time, color = color.new(cLvl, 20), style = line.style_dotted, force_overlay = true), keyAt(calK, 974))
        trimT(label.new(keyAt(calK, 974), gapCE, "gap 50%", xloc = xloc.bar_time, color = #00000000, textcolor = cLvl, style = label.style_label_left, size = size.tiny, tooltip = "RTH gap 50% = (yesterday's RTH close + 09:30 open) ÷ 2", force_overlay = true), keyAt(calK, 974))
// the 08:30–09:00 window: full-height lines at 08:30 and 09:00 and the band between them, strongest on CPI days
bool  inW     = mod < 540 and mod + tfM > 510
bool  winShow = gOn and wkd and timeframe.isintraday and (winDays == "Every weekday" or gCPI or (gAft and winDays == "CPI days and the day after"))
color winC    = gCPI ? cWinL : gAft ? color.new(cWinL, 45) : color.new(cWinL, 70)
if winShow and winLn
    for m in array.from(510, 540)
        if mod <= m and mod + tfM > m
            line.new(keyAt(calK, m), close, keyAt(calK, m), close + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = winC, width = winLW, force_overlay = true)
bgcolor(winShow and winBg and inW ? color.new(cWinL, gCPI ? 82 : gAft ? 90 : 95) : na, title = "08:30–09:00 window", force_overlay = true)
// the 08:30–09:00 CPI dealing range: high, low and CE, live through the window, then carried right to the range end
var float    c3H  = na
var float    c3L  = na
var int      c3K  = na
var line     c3Hl = na
var line     c3Ll = na
var line     c3Cl = na
var linefill c3Fl = na
var label    c3Ht = na
var label    c3Lt = na
string c3Tip = "CPI dealing range: the 08:30–09:00 high and low. NQ + ES + RTY 1-minute, 102 CPI days 2018–26 (304 symbol-days) vs normal days: the window ran a median 0.37 ADR20 (80%: 0.77) vs 0.12. After 09:00, RTH took its high by 16:14 on 74% of CPI days (normal 89%), its low 70% (87%), both 48% (77%), all held. The RTH close: above it 37% · inside 28% · below 35% (normal 48 · 10 · 42). Its direction did not carry: RTH closed the 08:30–09:00 way 48%."
string x25Tip = "±0.25: a quarter of the 08:30–09:00 range beyond its high and low. How often RTH (09:00–16:14) reached them on CPI days, NQ + ES + RTY 1-minute, 103 days 2018–26 (307 symbol-days): +0.25 above the high 62% (normal days 83%) · −0.25 below the low 60% (83%) · either 90% (100%) · both 32% (67%). Once the high broke, it carried on to +0.25 83% (94%); once the low broke, to −0.25 85% (95%). All held in 2018–24 and 2025–26 and on NQ, ES and RTY, but 2025–26 ran lower: +0.25 45%, −0.25 53%. CPI ranges are wide, so their extensions are reached less often than a normal day's."
if gOn and gCPI and showDR and tfM <= 30 and mod >= 510 and mod < 540
    float ce_ = na
    if nz(c3K) != calK
        c3K  := calK
        c3H  := high
        c3L  := low
        ce_  := (c3H + c3L) / 2
        c3Hl := line.new(time, c3H, time, c3H, xloc = xloc.bar_time, color = cDR, style = lsOf(stDR), width = wDR, force_overlay = true)
        c3Ll := line.new(time, c3L, time, c3L, xloc = xloc.bar_time, color = cDR, style = lsOf(stDR), width = wDR, force_overlay = true)
        c3Cl := drEq ? line.new(time, ce_, time, ce_, xloc = xloc.bar_time, color = color.new(cDR, 25), style = line.style_dotted, force_overlay = true) : na
        c3Fl := drFill ? linefill.new(c3Hl, c3Ll, color.new(cDR, 92)) : na
        c3Ht := label.new(time, c3H, "CPI DR high", xloc = xloc.bar_time, color = #00000000, textcolor = cDR, style = label.style_label_lower_left, size = lbSz, tooltip = c3Tip, force_overlay = true)
        c3Lt := label.new(time, c3L, "CPI DR low", xloc = xloc.bar_time, color = #00000000, textcolor = cDR, style = label.style_label_upper_left, size = lbSz, tooltip = c3Tip, force_overlay = true)
    else
        c3H := math.max(c3H, high)
        c3L := math.min(c3L, low)
        ce_ := (c3H + c3L) / 2
        c3Hl.set_y1(c3H)
        c3Hl.set_y2(c3H)
        c3Ll.set_y1(c3L)
        c3Ll.set_y2(c3L)
        c3Ht.set_y(c3H)
        c3Lt.set_y(c3L)
        if not na(c3Cl)
            c3Cl.set_y1(ce_)
            c3Cl.set_y2(ce_)
    c3Hl.set_x2(time)
    c3Ll.set_x2(time)
    if not na(c3Cl)
        c3Cl.set_x2(time)
// at 09:00 the range is fixed and runs right; the CE's label gives how often CPI days traded back to it from here
if c3K == calK and mod >= 540 and (mod[1] < 540 or calK != calK[1]) and not na(c3Hl)
    int   te  = keyAt(calK, drEndM)
    float ce_ = (c3H + c3L) / 2
    float cd  = tdO * ADRtd > 0 ? math.abs(close[1] - ce_) / (tdO * ADRtd) : na
    string od = na(cd) ? "" : cd <= 0.1 ? " · 94%" : cd <= 0.2 ? " · 85%" : cd <= 0.4 ? " · 71%" : " · 39%"
    trimL(c3Hl, te)
    trimL(c3Ll, te)
    if not na(c3Cl)
        trimL(c3Cl, te)
        trimT(label.new(te, ce_, "CPI CE" + od, xloc = xloc.bar_time, color = #00000000, textcolor = cDR, style = label.style_label_left, size = lbSz, tooltip = "CE = the 08:30–09:00 range's 50%. How often RTH traded back to it after 09:00 (by 16:14) on CPI days, by its distance from the 08:59 close: within 0.1 ADR20 94% · 0.1–0.2 85% · 0.2–0.4 71% · beyond 0.4 39% (2018–24 / 2025–26: 94 / 95 · 87 / 70 · 74 / 56). Normal days within 0.2 ADR: 94% · 85%. Read it as distance: a near CE gets traded, a far one less often. Today: " + (na(cd) ? "—" : str.tostring(cd, "0.00") + " ADR20") + ".", force_overlay = true), te)
    // ±0.25 of the range beyond its high and low, from 08:30 to the range end
    if drExt
        float r25 = (c3H - c3L) * 0.25
        int   t0_ = keyAt(calK, 510)
        trimL(line.new(t0_, c3H + r25, te, c3H + r25, xloc = xloc.bar_time, color = color.new(cDR, 35), style = line.style_dashed, force_overlay = true), te)
        trimL(line.new(t0_, c3L - r25, te, c3L - r25, xloc = xloc.bar_time, color = color.new(cDR, 35), style = line.style_dashed, force_overlay = true), te)
        trimT(label.new(te, c3H + r25, "CPI DR +0.25 · 62%", xloc = xloc.bar_time, color = #00000000, textcolor = color.new(cDR, 15), style = label.style_label_left, size = lbSz, tooltip = x25Tip, force_overlay = true), te)
        trimT(label.new(te, c3L - r25, "CPI DR −0.25 · 60%", xloc = xloc.bar_time, color = #00000000, textcolor = color.new(cDR, 15), style = label.style_label_left, size = lbSz, tooltip = x25Tip, force_overlay = true), te)
// the window's high / low box: CPI days, lighter on the day after
var box   wBx = na
var int   wK  = na
if gOn and showWin and (gCPI or gAft) and inW and wkd
    if nz(wK) != calK
        wK  := calK
        wBx := box.new(keyAt(calK, 510), high, keyAt(calK, 540), low, xloc = xloc.bar_time, border_color = color.new(cGh, gCPI ? 35 : 70), border_width = 1, bgcolor = color.new(cGh, gCPI ? 78 : 92), force_overlay = true)
    else
        wBx.set_top(math.max(wBx.get_top(), high))
        wBx.set_bottom(math.min(wBx.get_bottom(), low))
// the CPI flag: above the release bar, tied by a stem to the 08:30 open; it rises with the release push to 09:00. The day
// after and other days get a quiet tag (its wording box empty = none)
var label  wTx  = na
var line   wTs  = na
var int    wTxK = na
color  cPilM  = dark ? #2a2e39 : #e3e6ec
string noteTx = gCPI ? txCPI : gAft ? txAft : txOth
float  noteOf = (tdO * ADRtd > 0 ? tdO * ADRtd : tdH - tdL) * noteUp / 100.0
noteSz = noteSzI == "Tiny" ? size.tiny : noteSzI == "Small" ? size.small : noteSzI == "Normal" ? size.normal : noteSzI == "Large" ? size.large : size.huge
if gOn and showNot and wkd and (gCPI or noteTx != "") and mod <= 510 and mod + tfM > 510
    int    nx   = nextOf(CP, addDays(calK, 1))
    string nTip = gCPI ? "CPI day: the release is at 08:30 ET. The 08:30–09:00 half hour adds a median " + (isES ? "+0.19× ADR20 to the day range vs +0.03×" : "+0.19× ADR20 to the day range vs +0.02×") + " on normal days." : gAft ? "The trading day after a CPI day. Tested 2018–26: it went the same way as the CPI day " + (isES ? "46% ±10 of the time (any day → next day 49%)" : "44% ±10 of the time (any day → next day 48%)") + ", so no continuation edge showed up." : "Not a CPI day: a normal day's 08:30 one-minute candle is about 1/9 the size of a CPI one (medians)." + (na(nx) ? "" : " Next CPI: " + fmtDay(nx) + ".")
    float  yT   = high + noteOf
    wTxK := calK
    wTs  := gCPI ? line.new(time, open, time, yT, xloc = xloc.bar_time, color = color.new(cNote, 25), style = line.style_dotted, force_overlay = true) : na
    wTx  := label.new(time, yT, gCPI ? "CPI 08:30 · " + pf(open) + (noteTx == "" ? "" : "\n" + noteTx) : (gAft ? "CPI +1 · " : "") + noteTx, xloc = xloc.bar_time, color = gCPI ? cNote : cPilM, textcolor = gCPI ? #ffffff : cSub, style = label.style_label_down, size = gCPI ? noteSz : size.tiny, tooltip = nTip, force_overlay = true)
else if wTxK == calK and mod < 540 and not na(wTx) and high + noteOf > wTx.get_y()
    wTx.set_y(high + noteOf)
    if not na(wTs)
        wTs.set_y2(high + noteOf)
// NQ · ES · RTY against their week open at 08:30 and at the 09:30 open: one readout under the release, held below the
// candles to 10:00
var label  gjL  = na
var int    gjK  = na
var string gj8  = ""
var float  gjY  = na
wkPct(float px, float wo) => na(px) or na(wo) or wo == 0 ? na : (px / wo - 1) * 100
wkCell(float p) => na(p) ? "   —    " : (p >= 0 ? "▲" : "▼") + str.tostring(math.abs(p), "0.00") + "%"
padR(string s, int n) => s + str.repeat(" ", math.max(0, n - str.length(s)))
gjRow(string tm) =>
    float a = wkPct(nqO, nqW)
    float b = wkPct(esO, esW)
    float c = wkPct(ryO, ryW)
    bool  ok = not (na(a) or na(b) or na(c))
    int   up = (nz(a) > 0 ? 1 : 0) + (nz(b) > 0 ? 1 : 0) + (nz(c) > 0 ? 1 : 0)
    float lo = math.min(nz(a, 1e9), nz(b, 1e9), nz(c, 1e9))
    string wk = not ok ? "" : lo == a ? idxNm(0) : lo == b ? idxNm(1) : idxNm(2)
    string tg = not ok ? "" : up == 3 ? "all ▲" : up == 0 ? "all ▼" : "SPLIT"
    padR(tm, 7) + padR(wkCell(a), 8) + " " + padR(wkCell(b), 8) + " " + padR(wkCell(c), 8) + " " + padR(tg, 5) + (wk == "" ? "" : " weak " + wk)
gjHead() => "vs week open\n" + padR("", 7) + padR(idxNm(0), 8) + " " + padR(idxNm(1), 8) + " " + padR(idxNm(2), 8)
string gjTip = "Each index against its own week open (Sunday 18:00), in %, at the 08:30 release and the 09:30 open. SPLIT = they sit on different sides of their week opens, the SMT idea behind Genjutsu Kai; weak = the furthest below. NQ + ES + RTY 1-minute 2018–26: the index weakest at 08:30 was still the weakest at 16:14 on 71% of CPI days (the strongest still the strongest 78%), much as on any day (70%, 71%): relative strength carries through the day, CPI does not reset it. A split at 08:30 (29% of CPI days, 26% of others) usually stood: the odd one joined the others by 16:14 on 24% of CPI days (32% of others). A locator, not a direction call."
float gjOff = (tdO * ADRtd > 0 ? tdO * ADRtd : tdH - tdL) * 0.12
if gOn and gCPI and showWkO and mod <= 510 and mod + tfM > 510
    gjK := calK
    gj8 := gjRow("08:30")
    gjY := low - gjOff
    gjL := label.new(time, gjY, gjHead() + "\n" + gj8, xloc = xloc.bar_time, color = color.new(dark ? #161a23 : #f4f6f9, 0), textcolor = cTx, style = label.style_label_up, size = lbSz == size.tiny ? size.small : lbSz, text_font_family = font.family_monospace, textalign = text.align_left, tooltip = gjTip, force_overlay = true)
else if gjK == calK and not na(gjL) and mod < 600
    if mod <= 570 and mod + tfM > 570
        gjL.set_text(gjHead() + "\n" + gj8 + "\n" + gjRow("09:30"))
    if low - gjOff < gjY
        gjY := low - gjOff
        gjL.set_y(gjY)
// every CPI 08:30 candle, kept and extended to the right like NWOG / NDOG
var array<box>   RCB = array.new<box>()
var array<label> RCT = array.new<label>()
var float rcH = na
var float rcL = na
var int   rcK = na
int  rcLen = relLenI == "1 min" ? 1 : relLenI == "5 min" ? 5 : 15
bool inRC  = tfM <= rcLen ? (mod >= 510 and mod < 510 + rcLen) : (mod <= 510 and mod + tfM > 510)
if gCPI and inRC
    if nz(rcK) != calK
        rcK := calK
        rcH := high
        rcL := low
    else
        rcH := math.max(rcH, high)
        rcL := math.min(rcL, low)
if markEv and gCPI and rcK == calK and not inRC and inRC[1]
    int   eff = math.max(rcLen, tfM)
    float q1  = eff <= 1 ? (isES ? 0.161 : 0.146) : eff <= 5 ? (isES ? 0.209 : 0.202) : (isES ? 0.234 : 0.235)
    float q2  = eff <= 1 ? (isES ? 0.400 : 0.369) : eff <= 5 ? (isES ? 0.470 : 0.432) : (isES ? 0.504 : 0.464)
    float xr  = tdO * ADRtd > 0 ? (rcH - rcL) / (tdO * ADRtd) : na
    string cat = na(xr) ? "" : xr >= q2 ? " · wild" : xr < q1 ? " · quiet" : " · average"
    for b in RCB                                              // older CPI candles fade back, the latest stays strong
        b.set_bgcolor(color.new(cGh, 93))
        b.set_border_color(color.new(cGh, 55))
    for t in RCT
        t.set_textcolor(color.new(cGh, 35))
    RCB.push(box.new(keyAt(calK, 510), rcH, time, rcL, xloc = xloc.bar_time, border_color = color.new(cGh, 15), border_width = 1, bgcolor = color.new(cGh, 86), force_overlay = true))
    RCT.push(label.new(time, rcH, "CPI " + str.format_time(keyTime(calK), "dd/MM", TZ) + cat, xloc = xloc.bar_time, color = #00000000, textcolor = cGh, style = label.style_label_lower_left, size = size.small, tooltip = "CPI 08:30 candle (" + str.tostring(eff) + " min): " + pf(rcH - rcL) + " pts = " + (na(xr) ? "—" : str.tostring(xr, "0.00") + "× ADR20") + ". CPI release candles of this length since 2018: bottom third under " + str.tostring(q1, "0.00") + "× (quiet), top third over " + str.tostring(q2, "0.00") + "× (wild). A normal day's 08:30 candle of the same length is about " + (eff <= 1 ? "1/9" : eff <= 5 ? "1/5" : "1/4") + " the size of a CPI one (medians).", force_overlay = true))
    if RCB.size() > relKeep
        RCB.shift().delete()
        RCT.shift().delete()
if RCB.size() > 0
    for b in RCB
        b.set_right(time)
    for t in RCT
        t.set_x(time)

if GL.size() > 0
    for i = GL.size() - 1 to 0
        int e = GLE.get(i)
        GL.get(i).set_x2(math.min(e, time))
        if time >= e
            GL.remove(i)
            GLE.remove(i)
if GT.size() > 0
    for i = GT.size() - 1 to 0
        int e = GTE.get(i)
        GT.get(i).set_x(math.min(e, time))
        if time >= e
            GT.remove(i)
            GTE.remove(i)

// ═══════════════════════════════════════════════════════════════ Event clock (indicator pane)
bool clkTF = timeframe.isintraday and timeframe.in_seconds() <= 3600
bool clkGo = clkOn and clkTF and paneV == "Event clock"
bool clkR  = clkMet == "Range"
int  mSel  = clkR ? 0 : 1
NCK = 2
REL = "510"
var int  ckI   = NCK - 1                                     // today's baseline: this event if today is one, else normal
var bool ckEv  = false
var int  ckEvI = 0                                           // this indicator's event for today / the next one
if tdSt or barstate.isfirst
    [k_, now_, d_] = ownProfile(tdK, tdPK, tdK)
    ckEv  := now_
    ckEvI := ownCk(k_)
    ckI   := now_ ? ownCk(k_) : NCK - 1
int   elM  = (mod - 1080 + 1440) % 1440
float eEnd = math.min(1380.0, elM + tfM)
int   jB   = math.min(45, math.max(0, int(math.ceil(eEnd / 30.0)) - 1))
float fB   = math.max(0.0, math.min(1.0, (eEnd - 30.0 * jB) / 30.0))
float scP  = tdO * ADRtd
float vPts = clkR ? tdH - tdL : close - tdO
float vAdr = scP > 0 ? vPts / scP : na
float q25B = ckAt(ckI, mSel, 1, jB, fB)
float q75B = ckAt(ckI, mSel, 3, jB, fB)
string stB = na(vAdr) ? "" : vAdr > q75B ? "Above" : vAdr < q25B ? "Below" : "Inside"
bool  isTd = anchorKey(0, last_bar_time) == tdK
color liveC = stB == "Above" ? cHot : stB == "Below" ? cCold : cTx
plot(clkGo and isTd and not tdSt ? vPts : na, "Today", color = liveC, linewidth = 3, style = plot.style_linebr, display = display.all - display.status_line)
plot(clkGo and kPast and not isTd and not tdSt ? vPts : na, "Earlier days", color = color.new(cSub, 75), linewidth = 1, style = plot.style_linebr, display = display.all - display.status_line)
// invisible headroom: with the clock card at the top of the pane, the scale leaves room above the bands for it
bool  ckTop = showCk and ckOn == "Indicator pane" and str.startswith(ckPos, "Top")
float hdrm  = clkGo and scP > 0 ? math.max(ck(ckI, mSel, 4, 45), ck(NCK - 1, mSel, 4, 45)) * scP * (ckTop ? 1.75 : 1.1) : na
plot(hdrm, "Headroom", color = #00000000, editable = false, display = display.pane)

var array<polyline> KP = array.new<polyline>()
var array<line>     KL = array.new<line>()
var array<label>    KT = array.new<label>()
kPath(int i, int m, int k, int t0, float sc, color lc, int lw, string ls) =>
    array<chart.point> pts = array.new<chart.point>()
    pts.push(chart.point.from_time(t0, 0.0))
    for j = 0 to 45
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(i, m, k, j) * sc))
    polyline.new(pts, curved = false, closed = false, xloc = xloc.bar_time, line_color = lc, line_width = lw, line_style = ls)
kBand(int i, int m, int kUp, int kDn, int t0, float sc, color fc) =>
    array<chart.point> pts = array.new<chart.point>()
    pts.push(chart.point.from_time(t0, 0.0))
    for j = 0 to 45
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(i, m, kUp, j) * sc))
    for j = 45 to 0
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(i, m, kDn, j) * sc))
    polyline.new(pts, curved = false, closed = true, xloc = xloc.bar_time, line_color = #00000000, fill_color = fc)

if barstate.islast
    for p in KP
        p.delete()
    for l in KL
        l.delete()
    for t in KT
        t.delete()
    KP.clear()
    KL.clear()
    KT.clear()
    if clkGo and scP > 0
        int   t0  = keyAt(addDays(tdK, -1), 1080)
        int   tE  = t0 + 46 * 1800000
        color ce  = ckEv ? cGh : cSub
        int   iR  = ckEv ? NCK - 1 : ckEvI
        color cR  = ckEv ? cMu : color.new(cGh, 25)
        if kBands
            KP.push(kBand(ckI, mSel, 4, 0, t0, scP, color.new(ce, 90)))
            KP.push(kBand(ckI, mSel, 3, 1, t0, scP, color.new(ce, 80)))
        KP.push(kPath(ckI, mSel, 2, t0, scP, ce, 2, line.style_solid))
        KT.push(label.new(tE, ck(ckI, mSel, 2, 45) * scP, ckName(ckI) + " median " + pf(ck(ckI, mSel, 2, 45) * scP), xloc = xloc.bar_time, color = #00000000, textcolor = ce, style = label.style_label_left, size = size.tiny))
        if kRef
            KP.push(kPath(iR, mSel, 2, t0, scP, cR, 1, line.style_dashed))
            KT.push(label.new(tE, ck(iR, mSel, 2, 45) * scP, ckName(iR) + (ckEv ? "" : " (next)") + " " + pf(ck(iR, mSel, 2, 45) * scP), xloc = xloc.bar_time, color = #00000000, textcolor = cR, style = label.style_label_left, size = size.tiny))
        for s in str.split(REL, ",")
            float rm = str.tonumber(s)
            if not na(rm)
                int tr = keyAt(tdK, int(rm))
                KL.push(line.new(tr, 0.0, tr, scP, xloc = xloc.bar_time, extend = extend.both, color = color.new(cGh, ckEv ? 30 : 70), style = line.style_dotted))

// ═══════════════════════════════════════════════════════════════ PO3 candles (price chart, drawn on the last bar)
var array<box>   RB = array.new<box>()
var array<line>  RL = array.new<line>()
var array<label> RT = array.new<label>()
clearRight() =>
    for b in RB
        b.delete()
    for l in RL
        l.delete()
    for t in RT
        t.delete()
    RB.clear()
    RL.clear()
    RT.clear()
pxR(int x, float y, string tx, color c) =>
    RT.push(label.new(x, y, tx, color = #00000000, textcolor = c, style = label.style_label_left, size = pxSz, force_overlay = true))
pxL(int x, float y, string tx, color c) =>
    RT.push(label.new(x, y, tx, color = #00000000, textcolor = c, style = label.style_label_right, size = pxSz, force_overlay = true))
drawCandle(int x, int w, float o, float h, float l, float c) =>
    if not na(o) and not na(h) and not na(l) and not na(c)
        int xm = x + int(w / 2)
        RL.push(line.new(xm, h, xm, l, color = cWk, width = 1, force_overlay = true))
        RB.push(box.new(x, math.max(o, c), x + w, math.min(o, c), border_color = cWk, border_width = 1, bgcolor = c >= o ? cUp : cDn, force_overlay = true))
chip(int x, float y, string tx, string tip, bool above) =>
    RT.push(label.new(x, y, tx, color = cBg, textcolor = cTx, style = above ? label.style_label_down : label.style_label_up, size = chSz, tooltip = tip, text_font_family = font.family_monospace, textalign = text.align_left, force_overlay = true))

// ═══════════════════════════════════════════════════════════════ Cards
// Price chart: one stacked table in a corner holding the event card, the VIX card and the DXY card. Each card is an
// accent stripe, a header bar with a status pill and a tinted body; a thin gap separates them. The clock card
// (indicator pane by default) uses the same style. Five columns: stripe · key or ✓ · wording · value · comparison.
SC = 5
cBody  = dark ? #161a23 : #f4f6f9
cBody2 = dark ? #1c2130 : #e9edf3
cNeu   = dark ? #3a3f4b : #d1d4dc
cVx    = #7e57c2
cDxc   = #00897b
cPrem  = dark ? #ef5350 : #d32f2f
cDisc  = dark ? #66bb6a : #2e7d32
EV_N = 2 + (evMode == "Checklist" ? chkMax(isES) : 5) + 1        // header · sub-header · rows · NEXT
VX_N = 4
DX_N = 7
FD_N = 8                                                        // Fed card: header · sub · 2 odds · 3 path · move
KR   = 5
// Mobile: one narrow table with the same five columns (stripe · key · text · value · side): header, NOW, the held
// rows or the tally in short form, then one row each for VIX and DXY after a thin gap.
bool mob   = layI == "Mobile"
MB_N = 2 + (evMode == "Checklist" ? chkMax(isES) : 4)              // header · NOW · rows
var table TS  = na
var table TK  = na
var table TM  = na
var int   rEv = -1
var int   rVx = -1
var int   rDx = -1
var int   tkO = 0
var int   mEv = -1
var int   mVx = -1
var int   mDx = -1
var int   rFd = -1
var int   mFd = -1
gapOf(string on, string p) => p == "Top left" or p == "Top center" or (p == "Top right" and on == "Indicator pane")
if barstate.isfirst
    int o = gapOf("Price chart", crdPos) ? 1 : 0
    int r = o
    if mob
        if showEv
            mEv := r
            r += MB_N
        int g = r
        if (showVx or showDx or showFd) and r > o
            r += 1
        if showVx
            mVx := r
            r += 1
        if showDx
            mDx := r
            r += 1
        if showFd
            mFd := r
            r += 1
        if r > o
            TM := table.new(posOf(crdPos), SC, r, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
            if o == 1
                TM.cell(0, 0, "", height = 3.5, bgcolor = #00000000)
                TM.merge_cells(0, 0, SC - 1, 0)
            if mEv >= 0
                TM.merge_cells(1, mEv, 3, mEv)
            if g < r and g > o and (mVx > g or mDx > g or mFd > g)
                TM.cell(0, g, "", height = 0.6, bgcolor = #00000000)
                TM.merge_cells(0, g, SC - 1, g)
    else
        if showEv
            rEv := r
            r += EV_N
        if showVx
            r += r > o ? 1 : 0
            rVx := r
            r += VX_N
        if showDx
            r += r > o ? 1 : 0
            rDx := r
            r += DX_N
        if showFd
            r += r > o ? 1 : 0
            rFd := r
            r += FD_N
        if r > o
            TS := table.new(posOf(crdPos), SC, r, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
            if o == 1
                TS.cell(0, 0, "", height = 3.5, bgcolor = #00000000)
                TS.merge_cells(0, 0, SC - 1, 0)
            for st in array.from(rEv, rVx, rDx, rFd)
                if st >= 0
                    TS.merge_cells(1, st, 3, st)
                    if st > o
                        TS.cell(0, st - 1, "", height = 0.6, bgcolor = #00000000)
                        TS.merge_cells(0, st - 1, SC - 1, st - 1)
            if rEv >= 0
                TS.merge_cells(2, rEv + EV_N - 1, SC - 1, rEv + EV_N - 1)
        if showCk and paneV == "Event clock"
            tkO := gapOf(ckOn, ckPos) ? 1 : 0
            if ckOn == "Price chart"
                TK := table.new(posOf(ckPos), SC, KR + tkO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
            else
                TK := table.new(posOf(ckPos), SC, KR + tkO, bgcolor = #00000000, frame_width = 0, border_width = 0)
            if tkO == 1
                TK.cell(0, 0, "", height = ckOn == "Price chart" ? 3.5 : 7.0, bgcolor = #00000000)
                TK.merge_cells(0, 0, SC - 1, 0)
            TK.merge_cells(1, tkO, 3, tkO)
// card cells
tc(table t, int c, int r, string s, color fg, color bg, string tip = "", string ha = text.align_left, bool b = false) =>
    t.cell(c, r, s, text_color = fg, bgcolor = bg, text_size = crdSz, text_halign = ha, tooltip = tip, text_font_family = font.family_monospace, text_formatting = b ? text.format_bold : text.format_none)
stripe(table t, int r, color col) =>
    t.cell(0, r, "", bgcolor = col, width = 0.25)
cardHead(table t, int r, color col, string title, string tip, string pill, color pfg, color pbg) =>
    stripe(t, r, col)
    tc(t, 1, r, title, #ffffff, col, tip, text.align_left, true)
    tc(t, 4, r, pill, pfg, pbg, "", text.align_center, true)
cardSub(table t, int r, color col, string txt, string a1, string a2) =>
    stripe(t, r, col)
    tc(t, 1, r, "", cMu, cBody2)
    tc(t, 2, r, txt, cMu, cBody2)
    tc(t, 3, r, a1, cMu, cBody2, "", text.align_center)
    tc(t, 4, r, a2, cMu, cBody2, "", text.align_center)
// key is a ✓ pill when held, else a muted label; value in bold
cardRow(table t, int r, color col, string key, bool held, string lab, string v, string b, string tip, color vfg = na, color bfg = na) =>
    stripe(t, r, col)
    tc(t, 1, r, key, held ? #ffffff : cMu, held ? cOk : cBody, tip, text.align_center, held)
    tc(t, 2, r, lab, cTx, cBody, tip)
    tc(t, 3, r, v, na(vfg) ? cTx : vfg, cBody, tip, text.align_center, true)
    tc(t, 4, r, b, na(bfg) ? cMu : bfg, cBody, tip, text.align_center)
cardWide(table t, int r, color col, string key, string txt, string tip, color fg) =>
    stripe(t, r, col)
    tc(t, 1, r, key, cMu, cBody, "", text.align_center)
    tc(t, 2, r, txt, fg, cBody, tip)
// text gauges for the monospace cells
gauge(float frac) =>
    string out = "░░░░░░░░░░"
    if not na(frac)
        int k = int(math.round(math.max(0.0, math.min(1.0, frac)) * 10))
        out := str.repeat("█", k) + str.repeat("░", 10 - k)
    out
// five-cell battery for the mobile card
gauge5(float frac) =>
    string out = "░░░░░"
    if not na(frac)
        int k = int(math.round(math.max(0.0, math.min(1.0, frac)) * 5))
        out := str.repeat("█", k) + str.repeat("░", 5 - k)
    out
meter(float p) =>
    string out = "──────────"
    if not na(p)
        int k = int(math.round(math.max(0.0, math.min(100.0, p)) / 10.0))
        out := str.repeat("─", k) + "●" + str.repeat("─", 10 - k)
    out
octBar(int o) =>
    string out = ""
    for i = 1 to 8
        out += i == o ? "█" : "░"
    out
// where price sits in a range, in octants (1 = bottom eighth … 8 = top eighth)
octOf(float px, float h, float l) => na(h) or na(l) or h <= l ? na : math.min(8, int(math.floor((px - l) / (h - l) * 8)) + 1)
zoneOf(float h, float l) =>
    int    o  = octOf(close, h, l)
    string z  = na(o) ? "—" : o >= 7 ? "PREMIUM" : o <= 2 ? "DISCOUNT" : "EQUILIB."
    color  zb = na(o) ? cBody : o >= 7 ? cPrem : o <= 2 ? cDisc : cNeu
    color  zf = na(o) or (o > 2 and o < 7) ? cTx : #ffffff
    [o, z, zb, zf]
zoneTip(int o, float h, float l, string what) =>
    "This " + what + "'s range so far " + pf(l) + " – " + pf(h) + ": price is " + (na(o) ? "—" : p0((close - l) / (h - l))) + " of the way up (octant " + (na(o) ? "—" : str.tostring(o)) + " of 8), " + (na(l) ? "—" : pf(close - l)) + " above the low and " + (na(h) ? "—" : pf(h - close)) + " below the high. Top quarter (octants 7–8) = premium, bottom quarter (1–2) = discount. A locator, not a tested signal."
zoneRow(table t, int r, color col, string key, float h, float l, string what) =>
    [o, z, zb, zf] = zoneOf(h, l)
    string tip = zoneTip(o, h, l, what)
    stripe(t, r, col)
    tc(t, 1, r, key, cMu, cBody, tip, text.align_center)
    tc(t, 2, r, octBar(o) + "  O" + (na(o) ? "—" : str.tostring(o)) + " · +" + (na(l) ? "—" : pf(close - l)) + " from low", cTx, cBody, tip)
    tc(t, 3, r, z, zf, zb, tip, text.align_center, true)
    tc(t, 4, r, na(h) ? "—" : "−" + pf(h - close), cMu, cBody, tip + " Right: distance to the " + what + "'s high.", text.align_center)
// mobile version: octant bar and a short zone pill
zoneRowM(table t, int r, color col, string key, float h, float l, string what) =>
    [o, z, zb, zf] = zoneOf(h, l)
    string tip = zoneTip(o, h, l, what)
    stripe(t, r, col)
    tc(t, 1, r, key, cMu, cBody, tip, text.align_center)
    tc(t, 2, r, octBar(o) + " O" + (na(o) ? "—" : str.tostring(o)), cTx, cBody, tip)
    tc(t, 3, r, na(o) ? "—" : o >= 7 ? "PREM" : o <= 2 ? "DISC" : "EQ", zf, zb, tip, text.align_center, true)
    tc(t, 4, r, na(h) ? "—" : "−" + pf(h - close), cMu, cBody, tip, text.align_center)
// tally accumulator: 0 count · 1 up · 2 down · 3 RTH up · 4 RTH down · 5 gaps · 6 Σgap · 7 Σ|gap| · 8 Σ|gap %| · 9 gaps up
talAcc(array<float> acc, int t_, int r_, float g_, float p_) =>
    acc.set(0, acc.get(0) + 1)
    acc.set(1, acc.get(1) + (t_ > 0 ? 1 : 0))
    acc.set(2, acc.get(2) + (t_ < 0 ? 1 : 0))
    acc.set(3, acc.get(3) + (r_ > 0 ? 1 : 0))
    acc.set(4, acc.get(4) + (r_ < 0 ? 1 : 0))
    if not na(g_)
        acc.set(5, acc.get(5) + 1)
        acc.set(6, acc.get(6) + g_)
        acc.set(7, acc.get(7) + math.abs(g_))
        acc.set(8, acc.get(8) + (na(p_) ? 0.0 : math.abs(p_)))
        acc.set(9, acc.get(9) + (g_ > 0 ? 1 : 0))
// built-in event-day records for the tally (NQ / MNQ and ES / MES; other symbols use the chart's own history)
var array<int>   TEd = array.new<int>()
var array<int>   TEt = array.new<int>()
var array<int>   TEr = array.new<int>()
var array<float> TEg = array.new<float>()
var array<float> TEp = array.new<float>()
_isfirst_1() =>
    string src = isES ? TAL_ES : isNQ ? TAL_NQ : ""
    if src != ""
        for rec in str.split(src, ";")
            array<string> f = str.split(rec, ",")
            if f.size() >= 3
                TEd.push(int(str.tonumber(f.get(0))))
                TEt.push(int(str.tonumber(f.get(1))))
                TEr.push(int(str.tonumber(f.get(2))))
                TEg.push(f.size() > 3 ? str.tonumber(f.get(3)) : na)
                TEp.push(f.size() > 4 ? str.tonumber(f.get(4)) : na)
if barstate.isfirst
    _isfirst_1()

// ═══════════════════════════════════════════════════════════════ Draw (last bar)
// The last bar's values the PO3 candles, the chips and the cards share, set on the last bar. Pine caps the size of one
// if block (CE10205), so each part below is its own block.
bool pend = false
int tKey = na
int today = na
int pk = na
bool pNow = false
int pDay = na
int mTy = na
bool live = false
bool hasD = false
float O = na
color gc = na
float a = na
int gw = na
int xd = na
int x0 = na
int xc = na
int xw = na
bool hasS = false
bool shM = false
float vFac = na
float mR = na
float uS = na
float mH = na
float mL = na
float mC = na
string dot = ""
int dd = na
string ev = ""
string n1t = ""
int n1k = na
string n2t = ""
int n2k = na
bool warn = false
array<float> acc = na
string seq = ""
int d0 = na
int nT = na
int uT = na
int dT_ = na
int uR = na
int dR_ = na
int nG = na
float gAvg = na
float gAbs = na
string since = ""
string srcT = ""
string tTip = ""
string gTip = ""
bool vOk = false
float vsp = na
float vch = na
string st = ""
string bR = ""
string bA = ""
bool vDn = false
bool dOk = false
float net = na
float rg = na
float bigL = na
bool big = false
if barstate.islast
    clearRight()
if barstate.islast
    pend := AN == 2 and mod < 570                      // RTH not open yet: the model sits on the last price
    tKey := pend ? calK : dK
    today := calK
    [pk_, pNow_, pDay_] = ownProfile(tKey, pend ? dK : pK, today)
    pk := pk_
    pNow := pNow_
    pDay := pDay_
    mTy := ownTy(pk)                                  // this indicator's own event, never another event's
    live := pNow and not pend
    hasD := not pend and not na(dO)
    O := hasD ? dO : close
    gc := pNow ? cGh : color.new(cGh, 55)
    a := ADR
    gw := widI + 6
    xd := bar_index + offI
    x0 := na(dX) ? na : math.max(dX, bar_index - 4900)   // day start, capped inside the 5000-bar buffer
    xc := xd + int(gw / 2)
    xw := xd + gw + gapI
    hasS := ST.size() == 7 * NF and not na(a) and not na(O)
    shM := showGh and hasS and (pNow or offDayI == "Next event's model")
    // model candle: typical range of this event (median), split above / below the open in the ratio of the median
    // reaches, and the median close
    // optional VIX sizing: the event's median range scaled by today's VIX against its 20-day average and against ADR20
    vFac := 1.0
    if vixSize and not na(vPrev) and not na(vAvg) and vAvg > 0 and not na(ADRtd) and ADRtd > 0
        float iv = math.log(vPrev / math.sqrt(252.0)) - math.log(ADRtd * 100)
        float vs = math.log(vPrev / vAvg)
        vFac := math.exp((isES ? 0.308 : 0.261) * (iv - (isES ? IVRV_ES : IVRV_NQ)) + (isES ? 1.472 : 1.178) * vs)
    mR := hasS ? sv(mTy, 10) * a * O * vFac : na
    uS := hasS ? sv(mTy, 3) / math.max(sv(mTy, 3) + sv(mTy, 6), 1e-9) : na
    mH := O + mR * uS
    mL := O - mR * (1 - uS)
    mC := hasS ? O * (1 + sv(mTy, 8) * a * vFac) : na
if barstate.islast
    if shM
        RB.push(box.new(xd + 2, mH, xd + gw - 2, mL, border_color = color.new(gc, 40), border_style = line.style_dotted, bgcolor = color.new(gc, 90), force_overlay = true))
        RB.push(box.new(xd, math.max(O, mC), xd + gw, math.min(O, mC), border_color = gc, border_width = 1, bgcolor = color.new(gc, 70), force_overlay = true))
        RL.push(line.new(xd, mH, xd + gw, mH, color = gc, width = 2, force_overlay = true))
        RL.push(line.new(xd, mL, xd + gw, mL, color = gc, width = 2, force_overlay = true))
        if showPx
            pxL(xd, mH, pf(mH), gc)
            pxL(xd, mL, pf(mL), gc)
        if showPL and live and not na(x0)
            RL.push(line.new(x0, mH, xd, mH, color = color.new(gc, 45), style = line.style_dotted, force_overlay = true))
            RL.push(line.new(x0, mL, xd, mL, color = color.new(gc, 45), style = line.style_dotted, force_overlay = true))
if barstate.islast
    if hasD
        drawCandle(xd + 3, widI, dO, dH, dL, dC)
        if showPx
            pxR(xd + gw, dH, pf(dH), cSub)
            pxR(xd + gw, dL, pf(dL), cSub)
        if showLv and not na(x0)
            RL.push(line.new(x0, dO, xd, dO, color = color.new(cWk, 30), style = line.style_dotted, force_overlay = true))
            RL.push(line.new(x0, dH, xd, dH, color = color.new(cWk, 50), style = line.style_dotted, force_overlay = true))
            RL.push(line.new(x0, dL, xd, dL, color = color.new(cWk, 50), style = line.style_dotted, force_overlay = true))
if barstate.islast
    if showWk and not na(wO)
        drawCandle(xw, widI, wO, wH, wL, wC)
        if showPx
            pxR(xw + widI, wH, pf(wH), cSub)
            pxR(xw + widI, wL, pf(wL), cSub)
    // chips
if barstate.islast
    if showCh
        string dHd = (AN == 0 ? "1D" : AN == 1 ? "1D 00:00" : "1D RTH") + " · " + (pNow ? typeShort(mTy) + " DAY" : "next " + typeShort(mTy) + (na(pDay) ? "" : " " + fmtDay(pDay)))
        string dR  = hasD ? "range " + pf(dH - dL) : "range —"
        string dM  = hasS ? "model " + pf(mR) + (vFac != 1.0 ? " (VIX ×" + str.tostring(vFac, "0.00") + ")" : "") + (live and hasD and mR > 0 ? " · " + p0((dH - dL) / mR) + " filled" : "") : ""
        string dTip = hasS ? typeShort(mTy) + " days (" + str.tostring(sv(mTy, 0), "0") + " since 2018): median range " + x2(sv(mTy, 10)) + " ADR20 (middle half " + x2(sv(mTy, 9)) + "–" + x2(sv(mTy, 11)) + "), normal days " + x2(sv(6, 10)) + ". Split above / below the open in the ratio of the median reaches (" + x2(sv(mTy, 3)) + " up, " + x2(sv(mTy, 6)) + " down); the body runs to the median close (" + (sv(mTy, 8) >= 0 ? "+" : "") + x2(sv(mTy, 8)) + "), and " + p0(sv(mTy, 1)) + " of these days closed up. ADR20 = " + pf(a * O) + " pts." + (pNow ? "" : "\nNo " + typeShort(mTy) + " today: this is the next one's model at today's ADR, around today's candle. A size reference, not a forecast.") : "Needs 15+ days of history for ADR20."
        float yD   = math.max(nz(dH, O), shM ? mH : nz(dH, O))
        chip(xc, yD, dHd + "\n" + dR + (dM == "" ? "" : "\n" + dM), dTip, true)
        if showWk and not na(wO)
            chip(xw + int(widI / 2), wL, "1W\nrange " + pf(wH - wL), "This week so far (CME week, Sunday 18:00 open), in points.", false)

    // ── cards
if barstate.islast
    dot := barstate.isrealtime ? (beat % 2 == 0 ? "●" : "○") : "◆"
    dd := na(pDay) ? na : inDays(pDay, today)
    ev := typeShort(mTy)
    [n1t_, n1k_, n2t_, n2k_] = ownNext(today)
    n1t := n1t_
    n1k := n1k_
    n2t := n2t_
    n2k := n2k_
    warn := inDays(LAST_DATE, today) < 60
    // tally of the last N event days (both layouts): this chart's own records first, then built-in ones older than those
    acc := array.new_float(10, 0.0)
    seq := ""
    d0 := na
    if showEv and evMode == "Tally"
        if LTd.size() > 0
            for i = LTd.size() - 1 to 0
                if acc.get(0) < talN
                    talAcc(acc, LTt.get(i), LTr.get(i), LTg.get(i), LTp.get(i))
                    seq := (LTt.get(i) > 0 ? "▲" : LTt.get(i) < 0 ? "▼" : "·") + seq
                    d0 := LTd.get(i)
        int oldest = LTd.size() > 0 ? LTd.get(0) : 99999999
        if TEd.size() > 0
            for i = TEd.size() - 1 to 0
                if acc.get(0) < talN and TEd.get(i) < oldest
                    talAcc(acc, TEt.get(i), TEr.get(i), TEg.get(i), TEp.get(i))
                    seq := (TEt.get(i) > 0 ? "▲" : TEt.get(i) < 0 ? "▼" : "·") + seq
                    d0 := TEd.get(i)
    nT := int(acc.get(0))
    uT := int(acc.get(1))
    dT_ := int(acc.get(2))
    uR := int(acc.get(3))
    dR_ := int(acc.get(4))
    nG := int(acc.get(5))
    gAvg := nG > 0 ? acc.get(6) / nG : na
    gAbs := nG > 0 ? acc.get(7) / nG : na
    since := na(d0) ? "" : " since " + str.format_time(keyTime(d0), "MMM yyyy", TZ)
    srcT := TEd.size() > 0 ? " Built-in " + symR + " records run to " + str.format_time(keyTime(talEnd), "dd MMM yyyy", TZ) + "; later days, and any this chart loads itself, come from the chart's own bars." : " Records come from this chart's own bars (built-in history covers NQ / MNQ and ES / MES)."
    tTip := "Trading day (18:00 → 17:00) close vs open on the last " + str.tostring(nT) + " " + TAL_NAME + " days, oldest → newest: " + seq + ". RTH (09:30 → 16:14): ▲ " + str.tostring(uR) + " ▼ " + str.tostring(dR_) + ". A tally, not a forecast: across 2018–26 the up-close rate on these days was not different from normal days." + srcT
    gTip := "RTH gap = 09:30 open − prior trading day's 16:14 close. Average over the last " + str.tostring(nG) + " " + TAL_NAME + " days: " + (na(gAvg) ? "—" : pf(gAvg)) + " pts; average size " + (na(gAbs) ? "—" : pf(gAbs) + " pts (" + str.tostring(acc.get(8) / nG, "0.00") + "%)") + "; gapped up on " + str.tostring(int(acc.get(9))) + " of " + str.tostring(nG) + "."
    // VIX and DXY readings (both layouts)
    vOk := not na(vixL) and not na(vPrev) and not na(vAvg) and vAvg > 0 and vPrev > 0
    vsp := vOk ? vPrev / vAvg - 1 : na
    vch := vOk ? vixL / vPrev - 1 : na
    st := na(vsp) ? "—" : vsp >= 0.10 ? "HOT" : vsp <= -0.10 ? "CALM" : "NORMAL"
    bR := st == "HOT" ? (isES ? "1.37×" : "1.27×") : st == "CALM" ? (isES ? "0.64×" : "0.70×") : st == "NORMAL" ? (isES ? "0.90×" : "0.91×") : "—"
    bA := st == "HOT" ? (isES ? "76%" : "73%") : st == "CALM" ? (isES ? "10%" : "16%") : st == "NORMAL" ? (isES ? "39%" : "40%") : "—"
    vDn := vOk and vch < 0
    dOk := not na(dxL) and not na(dxTdO) and not na(dxAtr) and dxAtr > 0
    net := dOk ? dxL - dxTdO : na
    rg := dOk ? dxHi - dxLo : na
    bigL := dOk ? 0.5 * dxAtr : na
    big := dOk and math.abs(net) >= bigL
if barstate.islast
    if showEv and not na(TS) and rEv >= 0
        int    r0 = rEv
        cardHead(TS, r0, cGh, dot + " " + str.upper("Gran Rey Cero") + " · " + ev + " · " + symTag, pfName(pk) + ". Recomputed on " + symR + " 1-minute data 2018–26." + (isNQ or isES ? "" : " This chart is " + syminfo.root + ": the figures are " + symR + "'s."), pNow ? "TODAY" : na(dd) ? "—" : dd == 1 ? "TOMORROW" : "IN " + str.tostring(dd) + "D", pNow ? cGh : #ffffff, pNow ? #ffffff : color.new(#000000, 55))
        if evMode == "Checklist"
            cardSub(TS, r0 + 1, cGh, "held 2018–24 and 2025–26", ev, "normal")
            array<string> rows = str.split(chkRows(pk, isES), "|")
            for i = 0 to chkMax(isES) - 1
                if i < rows.size() and rows.get(i) != ""
                    array<string> f = str.split(rows.get(i), "~")
                    cardRow(TS, r0 + 2 + i, cGh, "✓", true, f.get(0), f.size() > 1 ? f.get(1) : "", f.size() > 2 ? f.get(2) : "", f.size() > 3 ? f.get(3) : "")
                else
                    cardRow(TS, r0 + 2 + i, cGh, "", false, i == 0 ? "nothing held on " + symR : "", "", "", "Every candidate row either failed p < 0.05 over 2018–26 or flipped in 2025–26 on this symbol.")
        else
            cardSub(TS, r0 + 1, cGh, "last " + str.tostring(nT) + " " + TAL_NAME + " days" + since, "▲ up", "▼ down")
            cardRow(TS, r0 + 2, cGh, "DAY", false, gauge(uT + dT_ > 0 ? float(uT) / (uT + dT_) : na) + " " + (uT + dT_ > 0 ? p0(float(uT) / (uT + dT_)) : "—"), "▲ " + str.tostring(uT), "▼ " + str.tostring(dT_), tTip, cDisc, cPrem)
            cardRow(TS, r0 + 3, cGh, "RTH", false, gauge(uR + dR_ > 0 ? float(uR) / (uR + dR_) : na) + " " + (uR + dR_ > 0 ? p0(float(uR) / (uR + dR_)) : "—"), "▲ " + str.tostring(uR), "▼ " + str.tostring(dR_), "RTH 09:30 → 16:14 close vs open on the same days (days without RTH data are left out).", cDisc, cPrem)
            cardRow(TS, r0 + 4, cGh, "GAP", false, "avg RTH gap · up " + str.tostring(int(acc.get(9))) + "/" + str.tostring(nG), na(gAvg) ? "—" : (gAvg >= 0 ? "+" : "") + pf(gAvg), na(gAbs) ? "—" : "±" + pf(gAbs), gTip)
            zoneRow(TS, r0 + 5, cGh, "WEEK", wH, wL, "week")
            zoneRow(TS, r0 + 6, cGh, "MONTH", moH, moL, "month")
        cardWide(TS, r0 + EV_N - 1, cGh, "NEXT", (na(n1k) ? "beyond loaded dates" : whenTxt(n1k, today)) + (na(n2k) ? "" : "  →  " + fmtDay(n2k)) + (warn ? " · UPDATE DATES" : ""), n1t + ". Release dates are built in up to " + str.format_time(keyTime(LAST_DATE), "dd MMM yyyy", TZ) + ": add next year's dates (federalreserve.gov, bls.gov/schedule) to S_FOMC, S_CPI and S_NFP, then raise LAST_DATE.", na(n1k) or warn ? cWarn : cTx)

    // ── VIX card: only what held (VIX against its own 20-day average → day range; same-day VIX direction)
if barstate.islast
    if showVx and not na(TS) and rVx >= 0
        int    r0  = rVx
        cardHead(TS, r0, cVx, dot + " VIX " + (vOk ? str.tostring(vixL, "0.00") + "  " + (vch >= 0 ? "▲ " : "▼ ") + str.tostring(math.abs(vch) * 100, "0.0") + "%" : "— (no data)"), "CBOE VIX, live against its prior close.", st, st == "HOT" or st == "CALM" ? #ffffff : cTx, st == "HOT" ? cHot : st == "CALM" ? cCold : cNeu)
        cardSub(TS, r0 + 1, cVx, "held 2018–24 and 2025–26", "days ran", "> ADR")
        cardRow(TS, r0 + 2, cVx, "VIX", false, "vs its 20-day avg " + (na(vsp) ? "—" : (vsp >= 0 ? "+" : "−") + str.tostring(math.abs(vsp) * 100, "0") + "%"), bR, bA, "VIX prior close against its 20-day average. Days with VIX ≥ 10% above it ran a median " + (isES ? "1.37× ADR20 (above ADR on 76% of days)" : "1.27× ADR20 (above ADR on 73% of days)") + "; within ±10% " + (isES ? "0.90× (39%)" : "0.91× (40%)") + "; ≥ 10% below " + (isES ? "0.64× (10%)" : "0.70× (16%)") + ". 2018–24 and 2025–26 alike. Added to a range forecast it lifted the 2025–26 R² from " + (isES ? "0.25 to 0.39" : "0.24 to 0.33") + " (" + symR + "). Range only, no direction.", st == "HOT" ? cHot : st == "CALM" ? cCold : cTx)
        cardRow(TS, r0 + 3, cVx, "DAY", false, "VIX " + (vDn ? "▼" : "▲") + " today → " + symR + " closed up", vOk ? (vDn ? (isES ? "80%" : "78%") : (isES ? "23%" : "25%")) : "—", "of days", "Same day, 2018–26: " + symR + " closed up (trading day) on " + (isES ? "80%" : "78%") + " of days VIX fell and " + (isES ? "23%" : "25%") + " of days it rose. It describes the day, it does not forecast it.")

    // ── DXY card (last three years: Oct 2023 → Aug 2026, first two years then the last one)
if barstate.islast
    if showDx and not na(TS) and rDx >= 0
        int    r0  = rDx
        cardHead(TS, r0, cDxc, dot + " DXY " + (dOk ? str.tostring(dxL, "0.00") + "  " + (net >= 0 ? "▲ " : "▼ ") + str.tostring(math.abs(nz(dxDay)) * 100, "0.00") + "%" : "— (no data)"), "DXY since the 18:00 open.", big ? "BIG DAY" : "USUAL DAY", big ? #ffffff : cTx, big ? cHot : cNeu)
        cardSub(TS, r0 + 1, cDxc, "last 3 years · held in both halves", "this", "other")
        cardRow(TS, r0 + 2, cDxc, "RANGE", false, gauge(dOk ? rg / dxAtr : na) + " " + (dOk ? p0(rg / dxAtr) : "—") + " of ATR", dOk ? str.tostring(rg, "0.00") : "—", dOk ? "ATR " + str.tostring(dxAtr, "0.00") : "—", "DXY's range since the 18:00 open against its 20-day ATR (completed days): how much of a usual day it has used.")
        cardRow(TS, r0 + 3, cDxc, "MOVE", false, gauge(dOk ? math.abs(net) / bigL : na) + " " + (dOk ? p0(math.min(1.0, math.abs(net) / bigL)) : "—") + " to big", dOk ? (net >= 0 ? "▲ " : "▼ ") + str.tostring(math.abs(net), "0.00") : "—", dOk ? "big " + str.tostring(bigL, "0.00") : "—", "DXY's net move since the 18:00 open against half its ATR20. A big DXY day = a net move of at least ½ ATR.", big ? cHot : cTx)
        cardRow(TS, r0 + 4, cDxc, "✓", true, "big DXY day → " + symR + " closed other way", isES ? "65%" : "60%", isES ? "53%" : "50%", "On big DXY days (net move ≥ ½ ATR20) " + symR + " closed the trading day the other way to DXY on " + (isES ? "65% (Oct 2023 – Sep 2025 63%, Oct 2025 – Aug 2026 70%)" : "60% (Oct 2023 – Sep 2025 58%, Oct 2025 – Aug 2026 67%)") + " vs " + (isES ? "53%" : "50%") + " on other days, n ≈ 270. Same day: it describes how the day finishes; from 10:00, 12:00 or 14:00 on, the rest of the day was a coin flip.")
        cardRow(TS, r0 + 5, cDxc, "✓", true, "DXY 4wk " + (na(dx4) ? "—" : (dx4 >= 0 ? "▲ " : "▼ ") + str.tostring(math.abs(dx4) * 100, "0.0") + "%") + " → day range", na(dx4) ? "—" : dx4 >= 0 ? (isES ? "0.96×" : "0.99×") : (isES ? "0.86×" : "0.88×"), na(dx4) ? "—" : dx4 >= 0 ? (isES ? "0.86×" : "0.88×") : (isES ? "0.96×" : "0.99×"), "Last completed week's 4-week DXY change. After a 4-week rise " + symR + " days ran a median " + (isES ? "0.96× ADR20 vs 0.86×" : "0.99× ADR20 vs 0.88×") + " after a fall (Oct 2023 – Sep 2025 and Oct 2025 – Aug 2026 alike; weekly test p 0.001). Over 2018–24 it did not show, and once VIX is known it adds little.")
        float ybp = na(ylL) or na(ylPrev) ? na : (ylL - ylPrev) * 100
        cardRow(TS, r0 + 6, cDxc, "10Y", false, na(ylL) ? "— (no data)" : str.tostring(ylL, "0.000") + "%  " + (na(ybp) ? "" : (ybp >= 0 ? "▲ " : "▼ ") + str.tostring(math.abs(ybp), "0.0") + "bp today"), "", "live", "US 10-year yield, live. Nothing about it held as a range or direction signal here (monthly data only), so it is a readout.")

    // ── mobile card: one narrow table. Header (event · when), NOW (the clock in one row), the held rows in short form or
    // the tally, then VIX and DXY in one row each. Every row keeps its full explanation in the tooltip.
if barstate.islast
    if mob and not na(TM)
        if showEv and mEv >= 0
            int    r0  = mEv
            string bdg = pNow ? "TODAY" : na(dd) ? "—" : dd == 1 ? "TMRW" : str.upper(str.format_time(keyTime(pDay), "EEE d", TZ))
            string hTip = pfName(pk) + ". Recomputed on " + symR + " 1-minute data 2018–26." + (isNQ or isES ? "" : " This chart is " + syminfo.root + ": the figures are " + symR + "'s.") + " Next: " + (na(n1k) ? "beyond the loaded dates" : whenTxt(n1k, today)) + (na(n2k) ? "" : ", then " + fmtDay(n2k)) + "." + (warn ? " Release dates run out on " + str.format_time(keyTime(LAST_DATE), "dd MMM yyyy", TZ) + ": add next year's to S_FOMC, S_CPI and S_NFP." : "")
            cardHead(TM, r0, cGh, dot + " " + str.upper("Gran Rey") + " · " + ev + " · " + symTag, hTip, warn ? "UPDATE" : bdg, warn or not pNow ? #ffffff : cGh, warn ? cWarn : pNow ? #ffffff : color.new(#000000, 55))
            if clkTF and not na(vAdr)
                float  q50m = ckAt(ckI, mSel, 2, jB, fB)
                string nTip = "Today so far (" + (clkR ? "range" : "net move") + " from the 18:00 open) against " + ckName(ckI) + " days at this time: median " + pf(q50m * scP) + ", middle half " + pf(q25B * scP) + "–" + pf(q75B * scP) + " pts at today's ADR20 (" + x2(q50m) + " typical, " + x2(vAdr) + " today). Above / below = outside that middle half."
                cardRow(TM, r0 + 1, cGh, "NOW", false, (clkR ? "range " : "net ") + (clkR or vPts < 0 ? "" : "+") + pf(vPts), x2(vAdr), "", nTip)
                tc(TM, 4, r0 + 1, str.upper(stB), stB == "Inside" ? cTx : #ffffff, stB == "Above" ? cHot : stB == "Below" ? cCold : cNeu, nTip, text.align_center, true)
            else
                cardRow(TM, r0 + 1, cGh, "NOW", false, not clkTF ? "clock: chart ≤ 60 min" : "needs 15+ days", "", "", "")
            if evMode == "Checklist"
                array<string> rows = str.split(chkRows(pk, isES), "|")
                for i = 0 to chkMax(isES) - 1
                    if i < rows.size() and rows.get(i) != ""
                        array<string> f = str.split(rows.get(i), "~")
                        string lab = str.replace_all(str.replace_all(str.replace_all(f.get(0), " (× ADR)", ""), " on the day", ""), " side", "")
                        cardRow(TM, r0 + 2 + i, cGh, "✓", true, lab, f.size() > 1 ? f.get(1) : "", f.size() > 2 ? f.get(2) : "", (f.size() > 3 ? f.get(3) : "") + " Held 2018–24 and 2025–26; grey = normal days.")
                    else
                        cardRow(TM, r0 + 2 + i, cGh, "", false, i == 0 ? "nothing held on " + symR : "", "", "", "")
            else
                cardRow(TM, r0 + 2, cGh, "DAY", false, "last " + str.tostring(nT) + " " + gauge5(uT + dT_ > 0 ? float(uT) / (uT + dT_) : na), "▲ " + str.tostring(uT), "▼ " + str.tostring(dT_), tTip, cDisc, cPrem)
                cardRow(TM, r0 + 3, cGh, "GAP", false, "avg gap · up " + str.tostring(int(acc.get(9))) + "/" + str.tostring(nG), na(gAvg) ? "—" : (gAvg >= 0 ? "+" : "") + pf(gAvg), na(gAbs) ? "—" : "±" + pf(gAbs), gTip)
                zoneRowM(TM, r0 + 4, cGh, "WK", wH, wL, "week")
                zoneRowM(TM, r0 + 5, cGh, "MO", moH, moL, "month")
        if showVx and mVx >= 0
            string vTip = "VIX " + (vOk ? str.tostring(vixL, "0.00") : "—") + ", prior close " + (na(vPrev) ? "—" : str.tostring(vPrev, "0.00")) + " against its 20-day average " + (na(vAvg) ? "—" : str.tostring(vAvg, "0.00")) + " (" + (na(vsp) ? "—" : (vsp >= 0 ? "+" : "−") + str.tostring(math.abs(vsp) * 100, "0") + "%") + "). Days with VIX ≥ 10% above its average ran a median " + (isES ? "1.37×" : "1.27×") + " ADR20, within ±10% " + (isES ? "0.90×" : "0.91×") + ", ≥ 10% below " + (isES ? "0.64×" : "0.70×") + " (" + symR + ", 2018–24 and 2025–26 alike): today's bucket is " + bR + ", above ADR on " + bA + " of such days. Same day: " + symR + " closed up on " + (isES ? "80%" : "78%") + " of days VIX fell and " + (isES ? "23%" : "25%") + " of days it rose (it describes the day, it does not forecast it)."
            cardRow(TM, mVx, cVx, "VIX", false, vOk ? str.tostring(vixL, "0.00") + " " + (vch >= 0 ? "▲" : "▼") + str.tostring(math.abs(vch) * 100, "0.0") + "%" : "no data", bR, "", vTip, st == "HOT" ? cHot : st == "CALM" ? cCold : cTx)
            tc(TM, 4, mVx, st == "NORMAL" ? "NORM" : st, st == "HOT" or st == "CALM" ? #ffffff : cTx, st == "HOT" ? cHot : st == "CALM" ? cCold : cNeu, vTip, text.align_center, true)
        if showDx and mDx >= 0
            float  fr   = dOk ? math.min(1.0, math.abs(net) / bigL) : na
            string xTip = "DXY " + (dOk ? str.tostring(dxL, "0.00") + ", " + (net >= 0 ? "+" : "−") + str.tostring(math.abs(net), "0.00") + " since the 18:00 open; its range so far is " + p0(rg / dxAtr) + " of its 20-day ATR (" + str.tostring(dxAtr, "0.00") + ")" : "—") + ". The battery is the net move against ½ ATR (" + (dOk ? str.tostring(bigL, "0.00") : "—") + "), the line for a big DXY day. On big days " + symR + " closed the trading day the other way to DXY on " + (isES ? "65%" : "60%") + " vs " + (isES ? "53%" : "50%") + " of other days (Oct 2023 – Aug 2026, held in both halves). Same day: it describes how the day finishes."
            cardRow(TM, mDx, cDxc, "DXY", false, not dOk ? "no data" : big ? symR + " other way " + (isES ? "65%" : "60%") : gauge5(fr) + " " + p0(fr), dOk ? (net >= 0 ? "▲" : "▼") + str.tostring(math.abs(nz(dxDay)) * 100, "0.00") + "%" : "—", "", xTip, big ? cHot : cTx)
            tc(TM, 4, mDx, big ? "BIG" : "USUAL", big ? #ffffff : cTx, big ? cHot : cNeu, xTip, text.align_center, true)

    // ── clock card
if barstate.islast
    if showCk and not na(TK)
        string bN   = ckName(ckI)
        string eN   = ckName(ckEvI)
        string nowT = hhmm(int(math.min(1439.0, (elM + tfM + 1080) % 1440)))
        int    r0   = tkO
        cardHead(TK, r0, cGh, dot + " " + str.upper("Gran Rey Cero") + " · CLOCK · " + nowT + " ET", "Today's running range (or net move) from the 18:00 open against the same time of day on " + bN + " days, 2018–26: paths from " + ckN(ckI, isES) + " " + bN + " days" + (ckI != NCK - 1 ? " and " + ckN(NCK - 1, isES) + " normal days" : "") + ", half-hour steps, scaled by today's ADR20" + (scP > 0 ? " (" + pf(scP) + " pts)." : "."), ckEv ? eN + " DAY" : "NORMAL", ckEv ? cGh : #ffffff, ckEv ? #ffffff : color.new(#000000, 55))
        if not clkTF or na(vAdr)
            cardRow(TK, r0 + 1, cGh, "CLOCK", false, not clkTF ? "needs an intraday chart ≤ 60 min" : "needs 15+ days of history", "", "", "")
            cardRow(TK, r0 + 2, cGh, "", false, "", "", "", "")
            cardRow(TK, r0 + 3, cGh, "", false, "", "", "", "")
        else
            float q10 = ckAt(ckI, mSel, 0, jB, fB)
            float q50 = ckAt(ckI, mSel, 2, jB, fB)
            float q90 = ckAt(ckI, mSel, 4, jB, fB)
            float pc  = pctQ(vAdr, q10, q25B, q50, q75B, q90)
            string mW = clkR ? "range" : "net"
            color sBg = stB == "Above" ? cHot : stB == "Below" ? cCold : cNeu
            color sFg = stB == "Inside" ? cTx : #ffffff
            cardRow(TK, r0 + 1, cGh, "NOW", false, mW + " " + (clkR ? "" : vPts >= 0 ? "+" : "") + pf(vPts) + " pts", x2(vAdr), "", "Today so far, in ADR20 of the trading day.")
            tc(TK, 4, r0 + 1, pill(stB), sFg, sBg, "Above / below = outside the middle half (25–75%) of " + bN + " days at this time.", text.align_center, true)
            cardRow(TK, r0 + 2, cGh, "vs " + bN, false, meter(pc) + " " + pTxt(pc), "typ " + x2(q50), "", bN + " days by " + nowT + ": median " + pf(q50 * scP) + ", middle half " + pf(q25B * scP) + "–" + pf(q75B * scP) + " pts (" + mW + ", at today's ADR20).", stB == "Above" ? cHot : stB == "Below" ? cCold : cTx)
            float sh = ckShAt(ckI, jB, fB)
            float rgT = tdH - tdL
            cardRow(TK, r0 + 3, cGh, "DONE", false, gauge(sh) + " " + p0(sh), sh >= 0.25 ? "→ " + pf(rgT / sh) : "—", "pts", "Median share of the final day range already made by this time on " + bN + " days; right: today's range so far ÷ that share, a rough full-day figure (shown from 25% on).")
        float bestD = -1.0
        int   bestJ = 0
        for j = 0 to 45
            float dj = ck(ckEvI, 0, 2, j) - (j > 0 ? ck(ckEvI, 0, 2, j - 1) : 0.0)
            if dj > bestD
                bestD := dj
                bestJ := j
        float nD = ck(NCK - 1, 0, 2, bestJ) - (bestJ > 0 ? ck(NCK - 1, 0, 2, bestJ - 1) : 0.0)
        cardRow(TK, r0 + 4, cGh, "BUSIEST", false, hhmm(stepEnd(bestJ - 1)) + "–" + hhmm(stepEnd(bestJ)), "+" + x2(bestD), "norm +" + x2(nD), "The half hour in which the median running range of " + eN + " days grows most, against normal days in the same half hour.", ckEv ? cGh : cTx)

// ═══════════════════════════════════════════════════════════════ Model-specific cards (their own last-bar blocks: Pine caps the size of one if block)

