// Gran Rey Cero (王虚の閃光) · Models 7–8: CPI days (released 08:30 ET).
// The model's own structure on the chart: stage 1 (the dealing range built in the hour before the release, the structure
// the release tests), yesterday's RTH close, the first side of the dealing range taken after the release, the 08:50 line
// between the release push and stage 2, the 08:30–09:00 window (full-height lines and shading every weekday, strongest on
// CPI days, with the day's wording held above price), the window's high / low box on CPI days and the day after, and every
// CPI 08:30 candle kept and extended to the right, labelled wild / average / quiet against past CPI candles.
// Price chart: two PO3-style candles to the right of price. The daily slot is the model candle (the typical OHLC of this
// event's days since 2018, scaled to today's ADR20 and anchored at today's open) with today's live candle filling it
// from inside; the weekly slot is the live week. Each carries a small chip with its range in points. The model candle
// is a map of typical size, not a forecast of direction.
// Indicator pane: the event clock. Today's running range (or net move from the 18:00 open) drawn live against the typical
// path of this event's days, half-hour by half-hour, with a card that reads the clock: where today stands, how much of
// the day these events have usually done by now, and their busiest half hour.
// Cards (price chart, Desktop or Mobile layout): the event card (a checklist of what held, or a tally of the last N event
// days with this week's and month's premium / discount octant), a VIX card and a DXY card with the macro reads that held.
// Built for NQ / MNQ and ES / MES. Every number was recomputed on their 1-minute data, Jan 2018 – Oct 2026 (ES to Aug 2026);
// a ✓ row held in 2018–24 and again in 2025–26 (p < 0.05 over the full sample, same side in both periods).
// Release dates were checked against the BLS and Federal Reserve schedules and are loaded to Dec 2027; update once a year.
// Candle idea after PO3-style HTF candle indicators; clock after Kyōka Suigetsu. Written from scratch.
// Concepts: ICT (Michael J. Huddleston).

indicator("Gran Rey Cero", "Gran Rey", overlay = false, max_boxes_count = 300, max_lines_count = 400, max_labels_count = 400, max_polylines_count = 60)

TZ = "America/New_York"

// ═══════════════════════════════════════════════════════════════ Inputs
grpW = "View"
paneI   = input.string("Event clock", "Pane", options = ["Event clock", "Cards only"], group = grpW, tooltip = "What the indicator pane shows. Event clock: today's running range (or net move) against CPI days at the same time of day. Cards only: an empty pane for the clock card if you keep it there.", display = display.none)
clkMet  = input.string("Range", "Clock measure", options = ["Range", "Net move"], group = grpW, tooltip = "Range: the day's high − low so far. Net move: price − the 18:00 open. Both in points, against the same measure on this event's days (2018–26), scaled to today's ADR20 of the trading day. Needs an intraday chart of 60 minutes or lower.", display = display.none)
themeI  = input.string("Auto", "Theme", options = ["Auto", "Dark", "Light"], group = grpW, tooltip = "Auto follows the chart background.", display = display.none)
layI    = input.string("Desktop", "Layout", options = ["Desktop", "Mobile"], group = grpW, tooltip = "Desktop: the event, VIX and DXY cards on the price chart and the clock card, every row.\nMobile: one narrow card for a phone screen. A header with the next or current event, a NOW row that reads the clock, the held rows (or the tally) in short form, and one line each for VIX and DXY. The clock card folds into the NOW row; the DXY range battery, the 4-week row and 10Y are left out. For a phone, use a separate chart layout set to Mobile, since layouts sync across devices.", display = display.none)
crdSzI  = input.string("Small", "Card text", options = ["Tiny", "Small", "Normal"], group = grpW, display = display.none)

grpE = "Event day"
anchorI  = input.string("Trading day (18:00)", "Day", options = ["Trading day (18:00)", "NY midnight", "RTH (09:30–16:14)"], group = grpE, tooltip = "Which day the daily candle and its model use.\nTrading day: the CME daily candle, 18:00 → 17:00 ET.\nNY midnight: 00:00 → 17:00 ET.\nRTH: 09:30 → 16:14 ET (close of the 16:14 bar).\nThe clock always runs on the trading day.", display = display.none)
showGh   = input.bool(true, "Model candle", group = grpE, inline = "g1", display = display.none)
offDayI  = input.string("Next event's model", "On other days", options = ["Next event's model", "Hide"], group = grpE, inline = "g1", tooltip = "The model candle always uses this indicator's own event. On its event days it is anchored to today's open. On other days it can show the next event's model, dimmed, around today's candle (a size reference, not a forecast), or be hidden.", display = display.none)
showPL   = input.bool(true, "Model high / low lines", group = grpE, inline = "g2", tooltip = "Dotted lines from the day's start to the model candle's high and low, on event days.", display = display.none)
markEv   = input.bool(true, "Mark releases", group = grpE, inline = "g3", display = display.none)
markD    = input.int(90, "and model structure for the last (days)", minval = 5, maxval = 400, group = grpE, inline = "g3", display = display.none)

grpS = "Model structure"
showStr = input.bool(true, "Draw the model's levels and windows", group = grpS, display = display.none)
cLvl    = input.color(#ffb300, "Levels", group = grpS, inline = "s1", display = display.none)
lblI    = input.string("Tiny", "Labels", options = ["Tiny", "Small", "Normal"], group = grpS, inline = "s1", display = display.none)
showDR0 = input.bool(true, "Pre-CPI range 07:30–08:29", group = grpS, inline = "d0", display = display.none)
cDR0    = input.color(#90a4ae, "", group = grpS, inline = "d0", display = display.none)
stDR0   = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = grpS, inline = "d0", tooltip = "Stage 1: the hour before the release, drawn live from 07:30. It stops at the bar where the release first takes one of its sides (marked 1st sweep). The first side taken went on to be the day's bigger move from 08:30 on 70% of NQ CPI days (67% ES) vs 56% on normal days.", display = display.none)
showDR  = input.bool(true, "CPI dealing range 08:30–09:00", group = grpS, inline = "d1", display = display.none)
cDR     = input.color(#ffb300, "", group = grpS, inline = "d1", display = display.none)
stDR    = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = grpS, inline = "d1", display = display.none)
wDR     = input.int(1, "", minval = 1, maxval = 4, group = grpS, inline = "d1", tooltip = "The 08:30–09:00 high and low, drawn live through the window, then fixed at 09:00 and carried right to the end you pick.", display = display.none)
drEq    = input.bool(true, "CE (50%)", group = grpS, inline = "d2", display = display.none)
drFill  = input.bool(false, "Fill", group = grpS, inline = "d2", display = display.none)
drExt   = input.bool(true, "±0.25", group = grpS, inline = "d2", display = display.none)
drEnd   = input.string("17:00", "Run to", options = ["11:00", "16:14", "17:00"], group = grpS, inline = "d2", tooltip = "17:00 = the end of the CME trading day.", display = display.none)
showWkO = input.bool(true, "NQ · ES · RTY vs week open at 08:30 and 09:30", group = grpS, tooltip = "One readout under the release: each index against its own week open (Sunday 18:00), at 08:30 and at the 09:30 open, the SMT idea behind Genjutsu Kai. Micro charts read MNQ · MES · M2K.", display = display.none)
relLenI = input.string("1 min", "08:30 candle", options = ["1 min", "5 min", "15 min"], group = grpS, inline = "s2", tooltip = "The CPI release candle kept and extended to the right. On a chart above this timeframe the bar holding 08:30 is used. Wild / average / quiet = top / middle / bottom third of CPI release candles of the same length since 2018, as a share of ADR20.", display = display.none)
relKeep = input.int(6, "keep last", minval = 1, maxval = 30, group = grpS, inline = "s2", display = display.none)
showWin = input.bool(false, "08:30–09:00 box", group = grpS, inline = "s3", display = display.none)
showYC  = input.bool(true, "Yesterday's RTH close", group = grpS, inline = "s3", display = display.none)
winLn   = input.bool(true, "08:30 / 09:00 lines", group = grpS, inline = "s4", display = display.none)
cWinL   = input.color(#2962ff, "", group = grpS, inline = "s4", display = display.none)
winLW   = input.int(3, "width", minval = 1, maxval = 10, group = grpS, inline = "s4", display = display.none)
winBg   = input.bool(true, "Shade the window", group = grpS, inline = "s5", display = display.none)
winDays = input.string("Every weekday", "on", options = ["Every weekday", "CPI days and the day after", "CPI days"], group = grpS, inline = "s5", tooltip = "Full-height lines at 08:30 and 09:00 ET with the window shaded between them, in the line colour: strongest on CPI days, lighter on the day after, faint on other weekdays.", display = display.none)
showNot = input.bool(true, "CPI flag and day wording", group = grpS, inline = "s6", display = display.none)
cNote   = input.color(#e53935, "", group = grpS, inline = "s6", display = display.none)
noteSzI = input.string("Small", "", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = grpS, inline = "s6", display = display.none)
noteUp  = input.int(12, "height", minval = 0, maxval = 300, group = grpS, inline = "s6", tooltip = "CPI day: a flag above the release bar, tied by a stem to the 08:30 open; it rises with the release push to 09:00. The day after and other days get a quiet tag instead. Height = % of ADR20 above the bar's high. Leave a wording box empty to hide that day's tag.", display = display.none)
txCPI   = input.string("here we go folks", "CPI day", group = grpS, display = display.none)
txAft   = input.string("you just missed me folks", "Day after", group = grpS, display = display.none)
txOth   = input.string("nothing to see here folks", "Other days", group = grpS, display = display.none)

grpC = "PO3 candles"
showWk = input.bool(true, "Weekly candle", group = grpC, inline = "c0", display = display.none)
showCh = input.bool(true, "Chips", group = grpC, inline = "c0", display = display.none)
chSzI  = input.string("Small", "", options = ["Tiny", "Small", "Normal"], group = grpC, inline = "c0", tooltip = "Chips: each candle's range in points. The daily chip adds the model's range and how much of it today has filled.", display = display.none)
offI   = input.int(24, "Offset", minval = 1, maxval = 100, group = grpC, inline = "c1", display = display.none)
widI   = input.int(8, "Width", minval = 2, maxval = 40, group = grpC, inline = "c1", display = display.none)
gapI   = input.int(10, "Gap", minval = 1, maxval = 40, group = grpC, inline = "c1", tooltip = "Offset from the last bar, today's candle width and the gap between the daily and weekly slots, in bars. The model candle is 6 bars wider than today's candle.", display = display.none)
cUp    = input.color(#4caf50, "Body", group = grpC, inline = "c2", display = display.none)
cDn    = input.color(#131722, "", group = grpC, inline = "c2", display = display.none)
cWk    = input.color(#787b86, "Wick", group = grpC, inline = "c2", display = display.none)
cGh    = input.color(#e53935, "Model", group = grpC, inline = "c2", display = display.none)
showPx = input.bool(true, "Prices", group = grpC, inline = "c3", display = display.none)
pxSzI  = input.string("Small", "", options = ["Tiny", "Small", "Normal"], group = grpC, inline = "c3", display = display.none)
showLv = input.bool(true, "Today's open / high / low lines", group = grpC, display = display.none)

grpK = "Event clock (indicator pane)"
clkOn  = paneI == "Event clock"
kBands = input.bool(true, "10–90 and 25–75 bands", group = grpK, display = display.none)
kRef   = input.bool(true, "Reference path", group = grpK, tooltip = "On event days: the normal-day median. On other days: the next event's median, so you can see how its day usually unfolds.", display = display.none)
kPast  = input.bool(true, "Earlier days, faded", group = grpK, display = display.none)
paneV = "Event clock"

grpR = "Cards"
crdPos  = input.string("Top right", "Price-chart cards", options = ["Top left", "Top center", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group = grpR, tooltip = "The event, VIX and DXY cards stack in one corner of the price chart.", display = display.none)
showEv  = input.bool(true, "Event card", group = grpR, inline = "r1", display = display.none)
evMode  = input.string("Checklist", "", options = ["Checklist", "Tally"], group = grpR, inline = "r1", display = display.none)
talN    = input.int(12, "last", minval = 3, maxval = 60, group = grpR, inline = "r1", tooltip = "Checklist: only results that held in 2018–24 and again in 2025–26 (p < 0.05 over the full sample, same side in both periods).\nTally: the last N event days (up / down closes, average RTH gap) and where price sits in this week's and this month's range, in octants: top quarter (octants 7–8) = premium, bottom quarter (1–2) = discount.", display = display.none)
showVx  = input.bool(true, "VIX card", group = grpR, inline = "r2", display = display.none)
showDx  = input.bool(true, "DXY card", group = grpR, inline = "r2", display = display.none)
showCk  = input.bool(true, "Clock card", group = grpR, inline = "r3", display = display.none)
ckOn    = input.string("Indicator pane", "", options = ["Price chart", "Indicator pane"], group = grpR, inline = "r3", display = display.none)
ckPos   = input.string("Top right", "", options = ["Top left", "Top center", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group = grpR, inline = "r3", display = display.none)

grpM = "VIX · DXY · 10Y"
vixSym  = input.symbol("CBOE:VIX", "VIX", group = grpM, inline = "m0", display = display.none)
vixSize = input.bool(false, "Size the model candle by VIX", group = grpM, inline = "m0", tooltip = "Scales the event's median range by today's VIX: its prior close against its 20-day average and against ADR20. Fitted on 2018–24, it lifted the out-of-sample (2025–26) day-range R² from 0.24 to 0.34 on NQ and from 0.25 to 0.41 on ES. A size map, not a direction.", display = display.none)
dxySym  = input.symbol("TVC:DXY", "DXY", group = grpM, inline = "m1", display = display.none)
ylSym   = input.symbol("TVC:US10Y", "10Y", group = grpM, inline = "m1", tooltip = "DXY rows tested on DXY futures over the last three years (Oct 2023 → Aug 2026), first two years then the last one. US10Y: live readout only, no tested edge.", display = display.none)
showFd = false

